# Все запросы к /api/* отдаёт единый входной файл. Служебные папки и конфиг закрыты.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Заголовок Authorization иногда не доходит до PHP (FastCGI) — передаём вручную
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L]
</IfModule>
<FilesMatch "^(config\.php|config\.example\.php|migrate\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
