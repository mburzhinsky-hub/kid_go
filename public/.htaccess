# Статический сайт Kids Go на Apache (хостинг reg.ru). Для GitHub Pages файл безвреден.
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Один адрес сайта: www.kids-go.fun → kids-go.fun (путь и параметры сохраняются). Правило стоит первым, чтобы сработать до остальных.
  RewriteCond %{HTTP_HOST} ^www\.kids-go\.fun$ [NC]
  RewriteRule ^(.*)$ https://kids-go.fun/$1 [R=301,L]
  # Короткая ссылка на подборку /c/<код>/: отдаём оболочку страницы с превью (название, описание, картинка) для мессенджеров
  RewriteRule ^c/([a-z0-9]{10})/?$ api/page.php?id=$1 [L,QSA]
</IfModule>
